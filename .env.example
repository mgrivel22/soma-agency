# URL publique du site (sitemap, Open Graph, données structurées).
# Laissez vide sur Vercel : l’URL de déploiement sera utilisée automatiquement.
# NEXT_PUBLIC_SITE_URL=https://somadigital.fr

# Option A — Formspree
# FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx

# Option B — Webhook (Tally, Make, n8n, API backend)
# CONTACT_WEBHOOK_URL=https://example.com/hooks/contact
